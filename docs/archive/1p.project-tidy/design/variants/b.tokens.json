 "slop": [
  {
   "where": "css",
   "pattern": "border-(left|right):\\s*3px solid var\\(--(tone|accent)"
  },
  {
   "where": "css",
   "pattern": "inset 3px 0 0"
  },
  {
   "where": "css",
   "pattern": "border:\\s*1px dashed"
  },
  {
   "where": "css",
   "pattern": "\\.count \\{[^}]*border:\\s*1px solid"
  },
  {
   "where": "css",
   "pattern": "letter-spacing:\\s*\\.\\d+em"
  },
  {
   "where": "html",
